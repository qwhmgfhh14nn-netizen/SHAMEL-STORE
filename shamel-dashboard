
(() => {
  "use strict";

  const $ = (id) => document.getElementById(id);

  // الحصول على الاتصال وقت الاستخدام، وليس وقت تحميل الملف
  function getDB() {
    return window.shamelSupabase || window.supabaseClient;
  }

  function show(id, message) {
    const element = $(id);
    if (element) element.textContent = message;
  }

  function getTarget(ids) {
    for (const id of ids) {
      const element = $(id);
      if (element) return element;
    }
    return null;
  }

  async function requireUser() {
    const db = getDB();

    if (!db) {
      throw new Error("اتصال قاعدة البيانات غير جاهز. راجع app.js.");
    }

    const { data, error } = await db.auth.getUser();
    if (error) throw error;
    if (!data.user) throw new Error("سجّل الدخول أولاً.");

    return { db, user: data.user };
  }

  async function getRole(db, userId) {
    const { data, error } = await db
      .from("user_roles")
      .select("role")
      .eq("user_id", userId);

    if (error) throw error;

    const roles = (data || []).map(row => row.role);

    if (roles.includes("owner")) return "owner";
    if (roles.includes("seller")) return "seller";
    return "buyer";
  }

  async function checkAccess(requiredRole) {
    const { db, user } = await requireUser();
    const role = await getRole(db, user.id);

    if (role !== requiredRole) {
      throw new Error("ليس لديك صلاحية الوصول لهذا القسم.");
    }

    return { db, user };
  }

  function showRows(ids, rows, columns) {
    const container = getTarget(ids);
    if (!container) return;

    if (!rows || rows.length === 0) {
      container.textContent = "لا توجد بيانات حالياً.";
      return;
    }

    const table = document.createElement("table");
    table.style.width = "100%";
    table.style.borderCollapse = "collapse";

    const header = document.createElement("tr");

    columns.forEach(column => {
      const th = document.createElement("th");
      th.textContent = column.label;
      th.style.padding = "10px";
      th.style.borderBottom = "1px solid #d4af37";
      header.appendChild(th);
    });

    table.appendChild(header);

    rows.forEach(row => {
      const tr = document.createElement("tr");

      columns.forEach(column => {
        const td = document.createElement("td");
        td.textContent = String(row[column.key] ?? "");
        td.style.padding = "10px";
        td.style.borderBottom = "1px solid #eee";
        tr.appendChild(td);
      });

      table.appendChild(tr);
    });

    container.replaceChildren(table);
  }

  async function loadTable(role, tableName, ids, columns, query) {
    try {
      const { db } = await checkAccess(role);

      let request = db.from(tableName).select(query || "*");

      const { data, error } = await request
        .order("created_at", { ascending: false })
        .limit(100);

      if (error) throw error;

      showRows(ids, data, columns);
    } catch (error) {
      show(ids[0], error.message);
    }
  }

  async function init() {
    try {
      const { db, user } = await requireUser();
      const role = await getRole(db, user.id);

      show(
        "dashboard-role",
        role === "owner"
          ? "مرحباً بك في لوحة المالك"
          : role === "seller"
            ? "مرحباً بك في لوحة التاجر"
            : "حساب عميل"
      );

      const ownerTools = $("owner-tools");
      const sellerTools = $("seller-tools");
      const noAccess = $("dashboard-no-access");

      if (ownerTools) {
        ownerTools.style.display = role === "owner" ? "block" : "none";
      }

      if (sellerTools) {
        sellerTools.style.display = role === "seller" ? "block" : "none";
      }

      if (noAccess) {
        noAccess.style.display =
          role === "buyer" ? "block" : "none";
      }
    } catch (error) {
      show("dashboard-role", error.message);
      show("dashboard-login-required", error.message);
    }
  }

  // أقسام المالك
  async function loadProducts() {
    await loadTable("owner", "products",
      ["owner-products-content", "owner-dashboard-content"],
      [
        { key: "name", label: "المنتج" },
        { key: "price", label: "السعر" },
        { key: "stock", label: "المخزون" },
        { key: "is_published", label: "منشور" }
      ],
      "id,name,price,stock,is_published,created_at"
    );
  }

  async function loadOrders() {
    await loadTable("owner", "orders",
      ["owner-orders-content", "owner-dashboard-content"],
      [
        { key: "id", label: "رقم الطلب" },
        { key: "buyer_id", label: "العميل" },
        { key: "total_amount", label: "الإجمالي" },
        { key: "status", label: "الحالة" }
      ],
      "id,buyer_id,total_amount,status,created_at"
    );
  }

  async function loadStores() {
    await loadTable("owner", "stores",
      ["owner-sellers-content", "owner-dashboard-content"],
      [
        { key: "name", label: "المتجر" },
        { key: "seller_id", label: "التاجر" },
        { key: "is_active", label: "نشط" }
      ],
      "id,name,seller_id,is_active,created_at"
    );
  }

  async function loadSubscriptionRequests() {
    await loadTable("owner", "subscription_requests",
      ["owner-subscriptions-content", "owner-dashboard-content"],
      [
        { key: "seller_id", label: "التاجر" },
        { key: "status", label: "الحالة" },
        { key: "created_at", label: "تاريخ الطلب" }
      ],
      "seller_id,plan_id,status,created_at"
    );
  }

  // أقسام التاجر
  async function loadMyProducts() {
    const ids = ["seller-products-content", "seller-dashboard-content"];

    try {
      const { db, user } = await checkAccess("seller");

      const { data: stores, error: storeError } = await db
        .from("stores")
        .select("id")
        .eq("seller_id", user.id);

      if (storeError) throw storeError;

      const storeIds = (stores || []).map(store => store.id);

      if (!storeIds.length) {
        show(ids[0], "لا يوجد متجر مرتبط بحسابك.");
        return;
      }

      const { data, error } = await db
        .from("products")
        .select("id,name,price,stock,is_published,created_at")
        .in("store_id", storeIds)
        .order("created_at", { ascending: false });

      if (error) throw error;

      showRows(ids, data, [
        { key: "name", label: "المنتج" },
        { key: "price", label: "السعر" },
        { key: "stock", label: "المخزون" },
        { key: "is_published", label: "منشور" }
      ]);
    } catch (error) {
      show(ids[0], error.message);
    }
  }

  async function loadMySubscriptions() {
    await loadTable("seller", "seller_subscriptions",
      ["seller-subscriptions-content", "seller-dashboard-content"],
      [
        { key: "status", label: "الحالة" },
        { key: "starts_at", label: "البداية" },
        { key: "ends_at", label: "النهاية" }
      ],
      "status,starts_at,ends_at,created_at"
    ).catch(() => {});
  }

  window.ShamelDashboard = {
    init,
    loadProducts,
    loadOrders,
    loadStores,
    loadSubscriptionRequests,
    loadMyProducts,
    loadMySubscriptions
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init);
  } else {
    init();
  }
})();
